# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Session cookie HMAC (>= 32 chars, openssl rand -hex 32)
SESSION_SECRET=

# WhatsApp Cloud API (mock si absents)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=otp_code
# WhatsApp Business Account ID — requis pour soumettre des templates custom à Meta
# (pas le phone number ID). Trouvé via Meta Business Suite → WhatsApp Manager.
# WHATSAPP_WABA_ID=
# Webhook Meta (configuré dans Meta Developer Console → Webhooks)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Override le nom du template UTILITY utilisé pour notifier les couples
# (cf. scripts/submit-whatsapp-templates.ts → template_status_update).
# WHATSAPP_TEMPLATE_STATUS_TEMPLATE=template_status_update
# Templates UTILITY de rappels J-7 / J-1 envoyés aux invités (cron quotidien
# `convex/reminders.ts`). Tant que ces templates ne sont pas validés côté Meta
# Business Manager, l'absence de ces env vars provoque un fallback email-only
# dans le cron — l'envoi WhatsApp est skip avec un warning.
# WHATSAPP_REMINDER_D7_TEMPLATE=wedding_reminder_d7
# WHATSAPP_REMINDER_D1_TEMPLATE=wedding_reminder_d1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Prices — grille canonique multi-devises (cf. .context/redesign-direction.md)
# Générer / synchroniser via : pnpx tsx scripts/sync-stripe-prices.ts
# Convention : STRIPE_PRICE_<PLAN>[_ANNUAL]_<CURRENCY> avec CURRENCY ∈ {EUR, MAD, TND}.
# Le nom legacy sans suffix devise (STRIPE_PRICE_ESSENTIAL=…) reste un alias EUR.
# XOF n'est PAS géré ici : il passe par CinetPay (cf. CINETPAY_*).
# B2C particuliers (one-shot)
# STRIPE_PRICE_ESSENTIAL_EUR=
# STRIPE_PRICE_ESSENTIAL_MAD=
# STRIPE_PRICE_ESSENTIAL_TND=
# STRIPE_PRICE_PREMIUM_EUR=
# STRIPE_PRICE_PREMIUM_MAD=
# STRIPE_PRICE_PREMIUM_TND=
# STRIPE_PRICE_POST_EVENT_UPSELL_EUR=
# STRIPE_PRICE_POST_EVENT_UPSELL_MAD=
# STRIPE_PRICE_POST_EVENT_UPSELL_TND=
# Pros — abonnement mensuel
# STRIPE_PRICE_STARTER_EUR=
# STRIPE_PRICE_STARTER_MAD=
# STRIPE_PRICE_STARTER_TND=
# STRIPE_PRICE_BUSINESS_EUR=
# STRIPE_PRICE_BUSINESS_MAD=
# STRIPE_PRICE_BUSINESS_TND=
# STRIPE_PRICE_AGENCY_EUR=
# STRIPE_PRICE_AGENCY_MAD=
# STRIPE_PRICE_AGENCY_TND=
# Pros — abonnement annuel (-20%)
# STRIPE_PRICE_STARTER_ANNUAL_EUR=
# STRIPE_PRICE_STARTER_ANNUAL_MAD=
# STRIPE_PRICE_STARTER_ANNUAL_TND=
# STRIPE_PRICE_BUSINESS_ANNUAL_EUR=
# STRIPE_PRICE_BUSINESS_ANNUAL_MAD=
# STRIPE_PRICE_BUSINESS_ANNUAL_TND=
# STRIPE_PRICE_AGENCY_ANNUAL_EUR=
# STRIPE_PRICE_AGENCY_ANNUAL_MAD=
# STRIPE_PRICE_AGENCY_ANNUAL_TND=
# Pro Pay-as-you-go (one-shot, 1 event)
# STRIPE_PRICE_PAYG_EVENT_EUR=
# STRIPE_PRICE_PAYG_EVENT_MAD=
# STRIPE_PRICE_PAYG_EVENT_TND=
# Aliases legacy (rétro-compat — résolus comme alias EUR si _EUR manque)
# STRIPE_PRICE_ESSENTIAL=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_POST_EVENT_UPSELL=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_AGENCY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# STRIPE_PRICE_AGENCY_ANNUAL=
# STRIPE_PRICE_PAYG_EVENT=

# CinetPay
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=

# Forcer le driver mock pour paiements en E2E
# PAYMENTS_DRIVER=mock

# AWS (IAM user wedillybird-dev avec AdministratorAccess en dev)
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=

# SES
SES_FROM_ADDRESS=noreply@wedillybird.com
SES_CONFIGURATION_SET=wedillybird-default
EMAIL_DRIVER=ses
# Forcer le driver mock pour tests/E2E
# EMAIL_DRIVER=mock

# S3 + CloudFront (rempli après cdk deploy)
# S3_BUCKET=wedillybird-media-prod
# CLOUDFRONT_DOMAIN=media.wedillybird.com

# Lambda HMAC pour callbacks Convex
# LAMBDA_CALLBACK_SECRET=

# OpenAI Moderation API (gratuit, conçu pour la modération de contenu).
# Si défini, le Lambda Rekognition appelle aussi cette API en sortie pour un
# double-check sémantique multimodal qui rattrape les illustrations / dessins
# que Rekognition Moderation Labels rate. Skip silencieux si absent.
# OPENAI_API_KEY=sk-…

# E2E test mode — force tous les drivers (WhatsApp + email) en mock, même
# si les credentials sont définis. Activé automatiquement par playwright.config
# côté webServer et doit être posé côté env Convex avant les tests E2E :
#   pnpx convex env set E2E_MODE 1
#   pnpm exec playwright test
#   pnpx convex env unset E2E_MODE
# Ne JAMAIS activer ce flag en prod.
# E2E_MODE=1
