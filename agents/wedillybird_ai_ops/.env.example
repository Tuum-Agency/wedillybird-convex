# CrewAI runtime
# CrewAI requires Python >=3.10,<3.14.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional Google/Gemini provider settings.
# Use this for Gemini text models or Veo video generation once billing is configured.
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-3.1-flash-lite-preview
WEDILLYBIRD_VIDEO_PROVIDER=stub

# Optional: set this when running the package outside the monorepo checkout.
WEDILLYBIRD_REPO_ROOT=../..

# Safety default: keep publication disabled unless a future approval workflow enables it.
WEDILLYBIRD_AI_PUBLICATION_ENABLED=0

# Social OAuth app credentials. Do not use account passwords.
# These are app/client credentials; user account tokens should be created through OAuth.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
