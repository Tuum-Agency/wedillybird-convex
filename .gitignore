# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# convex
.convex
# convex/_generated is committed so CI can typecheck/build without CONVEX_DEPLOYMENT

# tests
/coverage
/test-results
/playwright-report
/playwright/.cache
/blob-report

# typescript
*.tsbuildinfo
next-env.d.ts

# claude agent internals (réglages locaux) — mais les skills PROJET sont
# versionnés : ce sont des procédures d'équipe, au même titre que la doc.
# NB : « .claude/* » et non « .claude/ », sinon le répertoire entier est exclu
# et plus aucune ré-inclusion n'est possible.
.claude/*
!.claude/skills/
.gstack/
.env*.local

# CodeGraph index (local)
.codegraph/
