prev=$1
curr=$2
is_branch=$3

# Only on branch switches (not file checkouts)
[ "$is_branch" = "1" ] || exit 0

changed=$(git diff --name-only "$prev" "$curr" 2>/dev/null || true)

if echo "$changed" | grep -q "^convex/"; then
  echo "convex/ changed — resyncing functions..."
  unset CONVEX_URL CONVEX_SITE_URL
  pnpx convex dev --once
fi
